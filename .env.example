PORT=3000
DB_PATH=data/jobboard.db
LOG_LEVEL=info
# json or pretty; unset: pretty in a terminal, json when piped (DEC-034)
# LOG_FORMAT=pretty
# Saved LinkedIn login, written by node scripts/linkedin-login.ts (DEC-032)
LINKEDIN_SESSION_PATH=data/linkedin/session.json
# How the board's Find Now starts Claude Code, as a JSON array (DEC-052); the default is the claude on PATH
# CLAUDE_COMMAND=["claude"]
# Optional: a free Adzuna key turns on the Adzuna feed of scripts/fetch-sources.ts (DEC-035)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Where setup looks for your LinkedIn searches and your feeds (FR-24). Keep the defaults: the scripts read these two
# paths unless you pass them --config
# LINKEDIN_SEARCHES_PATH=data/linkedin-searches.json
# SOURCES_PATH=data/sources.json
