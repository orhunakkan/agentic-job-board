{
  "name": "agentic-job-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env scripts/start.ts",
    "dev": "node --env-file=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/perf",
    "lint": "eslint . --max-warnings 0 --flag unstable_native_nodejs_ts_config",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "test:static": "node scripts/board-report.ts static",
    "test:unit": "node scripts/board-report.ts unit",
    "test:coverage": "node scripts/board-report.ts coverage",
    "test:integration": "node scripts/board-report.ts integration",
    "test:api": "node scripts/board-report.ts api",
    "test:contract": "node scripts/board-report.ts contract",
    "test:security": "node scripts/board-report.ts security",
    "test:e2e": "node scripts/board-report.ts e2e",
    "test:smoke": "node scripts/board-report.ts smoke",
    "test:perf": "node scripts/board-report.ts perf",
    "test:bdd": "node scripts/board-report.ts bdd",
    "test:bdd:integration": "node scripts/board-report.ts bdd-integration",
    "test:bdd:api": "node scripts/board-report.ts bdd-api",
    "test:bdd:e2e": "node scripts/board-report.ts bdd-e2e",
    "test:bdd:smoke": "node scripts/board-report.ts bdd-smoke",
    "test:all": "node scripts/board-report.ts all",
    "report": "node scripts/board-report/open.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.72.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@playwright/test": "^1.64.1",
    "@axe-core/playwright": "^4.14.0",
    "@types/k6": "^2.3.0",
    "@cucumber/cucumber": "^13.3.0"
  }
}
