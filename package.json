{
  "name": "agentic-job-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env scripts/start.ts",
    "dev": "node --env-file=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/perf",
    "lint": "eslint . --max-warnings 0 --flag unstable_native_nodejs_ts_config",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "test:api": "vitest run --project api",
    "test:contract": "vitest run --project contract",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project chromium",
    "test:perf": "k6 run tests/perf/load.ts",
    "test:bdd": "npm run test:bdd:integration && npm run test:bdd:api && npm run test:bdd:e2e",
    "test:bdd:integration": "cucumber-js --profile integration",
    "test:bdd:api": "cucumber-js --profile api",
    "test:bdd:e2e": "cucumber-js --profile e2e-chromium && cucumber-js --profile e2e-firefox && cucumber-js --profile e2e-webkit && cucumber-js --profile e2e-mobile",
    "test:bdd:smoke": "cucumber-js --profile smoke",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.72.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@playwright/test": "^1.64.1",
    "@axe-core/playwright": "^4.14.0",
    "@types/k6": "^2.3.0",
    "@cucumber/cucumber": "^13.3.0"
  }
}
